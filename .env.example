# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roulette?sslmode=disable

# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Admin Panel Configuration
ADMIN_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password_here
SESSION_SECRET=super_secret_key_here
ALLOWED_IPS=127.0.0.1,::1,192.168.1.100
DISABLE_IP_FILTERS=true

# Rotator Configuration
ROTATION_INTERVAL=30s
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Payment System Configuration
DEFAULT_PAYMENT_PROVIDER=oxapay

# OxaPay Configuration
OXAPAY_API_KEY=your_oxapay_api_key_here
